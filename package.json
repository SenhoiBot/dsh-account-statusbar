{
  "name": "@local/dsh-account-statusbar",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Bottom status bar for the Harness Web UI whose first item is the DeepSeek account balance.",
  "author": "SenhoiBot <senhoi@qq.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SenhoiBot/dsh-account-statusbar.git"
  },
  "homepage": "https://github.com/SenhoiBot/dsh-account-statusbar#readme",
  "bugs": {
    "url": "https://github.com/SenhoiBot/dsh-account-statusbar/issues"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "dsh-plugin",
    "statusbar"
  ],
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-layout"
      ]
    }
  }
}
